# --- DynamoDB ---
# Local (docker compose up -d): leave AWS_ENDPOINT set, keys can be dummy values.
# Real AWS: remove AWS_ENDPOINT, use a real access key from IAM.
AWS_REGION=eu-central-1
AWS_ENDPOINT=http://localhost:8002
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_TABLE_NAME=signal-drift

# --- Redis / Valkey ---
# Local (docker compose): redis://localhost:6379
# Upstash: paste the connection URL it gives you.
REDIS_URL=redis://localhost:6379

PORT=8080
